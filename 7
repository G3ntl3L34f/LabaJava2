import java.util.*;
import java.lang.*;
import java.io.*;

public class dva {
    public static void main(String[] args){
       int n = Integer.parseInt(args[0]);
       for (int i = 0;; i++) {
           if (Math.pow(2, i) <= n) {
               System.out.println(Math.pow(2, i));
           }
           else {break;}
       }
    }
}
