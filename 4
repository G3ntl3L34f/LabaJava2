import java.util.*;
import java.lang.*;
import java.io.*;

public class dva {
    public static void main(String[] args){
       int n = Integer.parseInt(args[0]);
       double sum = 0;
       for (int i = 0; i < n; i++){
           double a = Math.random(); 
           sum += a;
           System.out.println(a);
       }
       System.out.println(sum/n);
        
    }
}
